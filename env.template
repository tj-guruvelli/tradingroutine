# Copy this file to .env locally and fill in your keys. .env is gitignored.
# In cloud routines, set these as environment variables ON THE ROUTINE itself —
# do NOT create a .env file in the cloud.

# --- Alpaca -------------------------------------------------------------
# SAFETY: defaults to PAPER trading. Get PAPER keys from the Alpaca dashboard
# (toggle to "Paper" first, then generate keys).
# To go LIVE later, change ALPACA_ENDPOINT to https://api.alpaca.markets/v2
# AND regenerate LIVE keys. This is a deliberate, separate step.
ALPACA_ENDPOINT=https://paper-api.alpaca.markets/v2
ALPACA_DATA_ENDPOINT=https://data.alpaca.markets/v2
ALPACA_API_KEY=your_alpaca_paper_api_key_here
ALPACA_SECRET_KEY=your_alpaca_paper_secret_key_here

# --- Perplexity (research) ---------------------------------------------
PERPLEXITY_API_KEY=your_perplexity_api_key_here
PERPLEXITY_MODEL=sonar

# --- ClickUp (notifications — posts to a Chat channel) -----------------
CLICKUP_API_KEY=your_clickup_api_key_here
CLICKUP_WORKSPACE_ID=your_clickup_workspace_id_here
CLICKUP_CHANNEL_ID=your_clickup_channel_id_here

# --- Telegram (notifications — primary channel) ------------------------
# Create a bot via @BotFather on Telegram, save the token below.
# Then message @userinfobot to get your chat_id.
# For a group chat: add your bot to the group and use the group's negative
# chat_id (e.g. -123456789).
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# --- Gappers scanner (Humbled Trader Scanner A) ------------------------
# Percent gap magnitude that qualifies (absolute value). Default 3.0.
GAP_THRESHOLD=3.0
# Minimum premarket volume (shares) — filter out illiquid gappers. Default 50000.
GAP_MIN_PREMARKET_VOLUME=50000
# Minimum share price — filter out sub-$3 penny gappers. Default 3.0.
GAP_MIN_PRICE=3.0

# --- Safety check + trading limits (config/rules.json overrides these) --
# Portfolio value used for position sizing math (falls back to Alpaca account equity if unset)
PORTFOLIO_VALUE_USD=10000
# Hard per-trade cap in $ (safety-check rejects orders above this)
MAX_TRADE_SIZE_USD=2000
# Hard daily trade cap (safety-check rejects when count would exceed)
MAX_TRADES_PER_DAY=3

# --- Apify (YouTube transcript scraper for strategy extraction) --------
# Only needed if you want to auto-extract a strategy from a trader's channel
# using prompts/01-extract-strategy.md from the claude-execute pattern.
APIFY_API_KEY=

# --- AlphaInsider (forward-testing via TradingView webhook -> Alpaca paper)
# Set the webhook URL AlphaInsider gives you when you connect Alpaca PAPER.
# NEVER put a live-broker webhook here.
ALPHAINSIDER_WEBHOOK_URL=
# Optional shared secret AlphaInsider sends in the webhook header
ALPHAINSIDER_WEBHOOK_SECRET=

# --- MASSIVE (market data connector — see IG reel reference) -----------
# Optional Massive API key for deeper stock data across Claude Desktop.
MASSIVE_API_KEY=

# --- Loop-runner brakes (see docs/STOP-CONDITIONS.md) ------------------
# Per-run turn cap for the claude CLI. Loop-runner default: 50.
LOOP_MAX_TURNS=50
# Per-run $ ceiling. Loop-runner default: 2.00.
LOOP_MAX_BUDGET_USD=2.00
# Watchdog silence timeout in seconds. Loop-runner default: 180.
LOOP_WATCHDOG_SECONDS=180
